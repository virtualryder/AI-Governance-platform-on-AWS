{
  "name": "aws-governed-ai-platform",
  "version": "0.1.0",
  "description": "Governed AI agent platform on Amazon Bedrock AgentCore - deployable hub/spoke/standalone CDK framework",
  "private": true,
  "bin": { "platform": "bin/platform.js" },
  "scripts": {
    "build": "tsc",
    "gen:config": "node scripts/generate-config.js",
    "watch": "tsc -w",
    "test": "jest",
    "test:lambda": "python -m pytest test/lambda -q",
    "synth": "cdk synth --quiet",
    "synth:standalone": "cdk synth --quiet -c mode=standalone",
    "synth:hub": "cdk synth --quiet -c mode=hub",
    "synth:spoke": "cdk synth --quiet -c mode=spoke",
    "synth:org": "cdk synth --quiet -c mode=org",
    "nag": "cdk synth --quiet -c nag=true",
    "nag:standalone": "cdk synth --quiet -c mode=standalone -c nag=true",
    "nag:spoke": "cdk synth --quiet -c mode=spoke -c nag=true",
    "nag:hub": "cdk synth --quiet -c mode=hub -c nag=true",
    "nag:org": "cdk synth --quiet -c mode=org -c nag=true",
    "nag:all": "npm run nag:standalone && npm run nag:spoke && npm run nag:hub && npm run nag:org"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "aws-cdk": "2.1146.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "^2.35.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  }
}
